<div style="max-width:600px; margin:0 auto;">
  <div style="text-align: center;">
    <h1 style="margin-bottom:5px">予約を編集する</h1>
    <p class="room-name" style="font-size:20px">ホテル名：<%= @room.name %></h2>
    <p class="room-price" style="font-size:20px">宿泊費：¥<%= number_with_delimiter(@room.price) %>/日</p>
  </div>

  <% if @reservation.errors.any? %>
    <div style="background:#f8d7da; color:#721c24; padding:12px; border-radius:4px; margin-bottom:16px;">
      <% @reservation.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <%= form_with model: @reservation, data: { turbo: false } do |f| %>
    <div>
      <%= f.label :check_in do %>
        <span style="color:red;">*</span>
        チェックイン日
      <% end %>
      <%= f.date_field :check_in %>
    </div>
    <div>
      <%= f.label :check_out do %>
        <span style="color:red;">*</span>
        チェックアウト日
      <% end %>
      <%= f.date_field :check_out %>
    </div>
    <div>
      <%= f.label :guests do %>
        <span style="color:red;">*</span>
        人数
      <% end %>
      <%= f.number_field :guests %>
    </div>
    <div style="display:flex; justify-content:center; align-items:center; margin-top:16px;">
      <div style="margin-right:48px;">
        <%= link_to "戻る", reservation_path(@reservation),
        style: "background:#888; color:white; padding:8px 20px; border-radius:4px;" %>
      </div>
      <div>
        <%= f.submit "更新する" %>
      </div>
    </div>
  <% end %>
</div>