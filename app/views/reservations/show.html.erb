<h1>予約詳細</h1>

<div class="room-card" style="max-width: 600px;">
  <% if @reservation.room.room_image.attached? %>
    <%= image_tag @reservation.room.room_image, class: "room-image" %>
  <% else %>
    <%= image_tag "default_room.png", class: "room-image" %>
  <% end %>
  <div class="room-info">
    <p class="room-name"><%= @reservation.room.name %></p>
    <p><%= @reservation.room.description %></p>
    <% nights = (@reservation.check_out - @reservation.check_in).to_i %>
    <p>合計料金：¥<%= @reservation.room.price * nights * @reservation.guests %></p>
    <p>チェックイン：<%= @reservation.check_in.strftime("%Y/%m/%d") %></p>
    <p>チェックアウト：<%= @reservation.check_out.strftime("%Y/%m/%d") %></p>
    <p>宿泊料金：¥<%= @reservation.room.price %>/日</p>
    <p>宿泊日数：<%= nights %>泊</p>
    <p>人数：<%= @reservation.guests %>人</p>
    <p>予約確定日時：<%= @reservation.created_at.strftime("%Y/%m/%d %H:%M") %></p>

    <div style="display:flex; gap:12px; margin-top:16px;">
      <%= link_to "編集する", edit_reservation_path(@reservation), style: "background:#e74c3c; color:white; padding:8px 20px; border-radius:4px;" %>
      <button onclick="document.getElementById('delete-modal').style.display='flex'" style="background:#e74c3c; color:white; padding:8px 20px; border-radius:4px; border:none; cursor:pointer; font-size:1rem;">削除する</button>
      <%= link_to "戻る", reservations_path, style: "background:#888; color:white; padding:8px 20px; border-radius:4px;" %>
    </div>
  </div>
</div>

<!-- 削除確認モーダル -->
<div id="delete-modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); justify-content:center; align-items:center;">
  <div style="background:white; padding:32px; border-radius:8px; max-width:400px; width:90%;">
    <h2>予約を削除しますか？</h2>
    <% if @reservation.room.room_image.attached? %>
      <%= image_tag @reservation.room.room_image, style: "width: 200px; height: 150px; object-fit: cover;" %>
    <% else %>
      <%= image_tag "default_room.png", style: "width: 200px; height: 150px; object-fit: cover;" %>
    <% end %>
    <p><%= @reservation.room.name %></p>
    <p>¥<%= @reservation.room.price %>/日</p>
    <p>チェックイン：<%= @reservation.check_in.strftime("%Y/%m/%d") %></p>
    <p>チェックアウト：<%= @reservation.check_out.strftime("%Y/%m/%d") %></p>
    <p>人数：<%= @reservation.guests %>人</p>
    <div style="margin-top:24px; display:flex; gap:16px;">
      <%= link_to "削除する", reservation_path(@reservation), data: { turbo_method: :delete }, style: "background:#e74c3c; color:white; padding:8px 20px; border-radius:4px;" %>
      <button onclick="document.getElementById('delete-modal').style.display='none'" style="background:#888; color:white; padding:8px 20px; border-radius:4px; border:none; cursor:pointer;">キャンセル</button>
    </div>
  </div>
</div>