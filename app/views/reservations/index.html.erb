<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;">
  <h1>予約施設一覧</h1>
  <%= link_to "施設を予約する", search_rooms_path, style: "background:#e74c3c; color:white; padding:8px 20px; border-radius:4px; text-decoration:none;" %>
</div>

<div class="room-grid">
  <% @reservations.each do |reservation| %>
    <div class="room-card">
      <% if reservation.room.room_image.attached? %>
        <%= image_tag reservation.room.room_image, class: "room-image" %>
      <% else %>
        <%= image_tag "default_room.png", class: "room-image" %>
      <% end %>
      <div class="room-info">
        <%= link_to reservation.room.name, reservation_path(reservation), class: "room-name" %>
        <p class="room-description"><%= reservation.room.description %></p>
        <% nights = (reservation.check_out - reservation.check_in).to_i %>
        <p class="room-date">チェックイン：<%= reservation.check_in.strftime("%Y/%m/%d") %></p>
        <p class="room-date">チェックアウト：<%= reservation.check_out.strftime("%Y/%m/%d") %></p>
        <p class="room-date">予約確定日時：<%= reservation.created_at.strftime("%Y/%m/%d %H:%M") %></p>
        <p class="room-price">合計料金：¥<%= number_with_delimiter(reservation.room.price * nights * reservation.guests) %></p>
      </div>
    </div>
  <% end %>
</div>