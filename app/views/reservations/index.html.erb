<h1>予約一覧</h1>

<% @reservations.each do |reservation| %>
  <div>
    <% if reservation.room.room_image.attached? %>
      <%= image_tag reservation.room.room_image %>
    <% else %>
      <%= image_tag "default_room.png" %>
    <% end %>
    <p><%= reservation.room.name %></p>
    <p><%= reservation.room.description %></p>
    <% nights = (reservation.check_out - reservation.check_in).to_i %>
    <p>合計料金：¥<%= reservation.room.price * nights * reservation.guests %></p>
    <p>チェックイン：<%= reservation.check_in.strftime("%Y/%m/%d") %></p>
    <p>チェックアウト：<%= reservation.check_out.strftime("%Y/%m/%d") %></p>
    <p>予約確定日時：<%= reservation.created_at.strftime("%Y/%m/%d %H:%M") %></p>
    <%= link_to "削除", reservation_path(reservation), data: { turbo_method: :delete, turbo_confirm: "予約を削除しますか？" } %>
  </div>
<% end %>