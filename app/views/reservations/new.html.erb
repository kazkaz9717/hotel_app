<h1>予約する</h1>

<h2><%= @room.name %></h2>
<p>¥<%= @room.price %>/日</p>

<%= form_with model: @reservation, url: reservations_path do |f| %>
  <%= hidden_field_tag :room_id, @room.id %>
  <div>
    <%= f.label :check_in, "チェックイン日" %>
    <%= f.date_field :check_in %>
  </div>
  <div>
    <%= f.label :check_out, "チェックアウト日" %>
    <%= f.date_field :check_out %>
  </div>
  <div>
    <%= f.label :guests, "人数" %>
    <%= f.number_field :guests %>
  </div>
  <%= f.submit "予約を確定する" %>
<% end %>

<%= link_to "戻る", room_path(@room) %>