<div class="auth-container">
  <h1>ログイン</h1>

  <% if alert %>
    <div style="background:#f8d7da; color:#721c24; padding:12px; border-radius:4px; margin-bottom:16px;">
      <%= alert %>
    </div>
  <% end %>

  <%= form_with url: login_path do |f| %>
    <div>
      <%= f.label :email do %>
        <span style="color:red;">*</span>
        メールアドレス
      <% end %>
      <%= f.email_field :email, value: params[:email] %>
    </div>
    <div>
      <%= f.label :password do %>
        <span style="color:red;">*</span>
        パスワード
      <% end %>
      <%= f.password_field :password %>
    </div>
    <%= f.submit "ログイン" %>
  <% end %>

  <p style="margin-top: 16px; text-align: center;">
    アカウントをお持ちでない方は<%= link_to "新規登録", signup_path %>
  </p>
</div>