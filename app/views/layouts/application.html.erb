<!DOCTYPE html>
<html>
  <head>
    <title>HotelApp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header>
      <nav>
        <%= link_to "HotelApp", root_path %>
        <div>
          <%= form_with url: search_rooms_path, method: :get do |f| %>
            <%= f.select :area, [["エリアを選択", ""], ["東京", "東京"], ["大阪", "大阪"], ["京都", "京都"], ["札幌", "札幌"]] %>
            <%= f.text_field :keyword, placeholder: "フリーワード検索" %>
            <%= f.submit "検索" %>
          <% end %>
        </div>
        <div>
          <% if logged_in? %>
            <%= link_to current_user.name, account_users_path %>
            <%= link_to "施設一覧", rooms_path %>
            <%= link_to "予約一覧", reservations_path %>
            <%= link_to "ログアウト", logout_path, data: { turbo_method: :delete } %>
          <% else %>
            <%= link_to "ログイン", login_path %>
            <%= link_to "新規登録", signup_path %>
          <% end %>
        </div>
      </nav>
    </header>

    <main>
      <% if notice %>
        <p><%= notice %></p>
      <% end %>
      <% if alert %>
        <p><%= alert %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>