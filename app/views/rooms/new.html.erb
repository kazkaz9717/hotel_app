<h1>施設登録</h1>

<%= form_with model: @room do |f| %>
  <div>
    <%= f.label :name, "施設名" %>
    <%= f.text_field :name %>
  </div>
  <div>
    <%= f.label :description, "施設詳細" %>
    <%= f.text_area :description %>
  </div>
  <div>
    <%= f.label :price, "料金（円/日）" %>
    <%= f.number_field :price %>
  </div>
  <div>
    <%= f.label :address, "住所" %>
    <%= f.text_field :address %>
  </div>
  <div>
    <%= f.label :room_image, "施設画像URL" %>
    <%= f.text_field :room_image %>
  </div>
  <%= f.submit "登録する" %>
<% end %>

<%= link_to "戻る", rooms_path %>