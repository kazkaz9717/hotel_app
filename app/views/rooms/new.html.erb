<h1>施設登録</h1>

<% if @room.errors.any? %>
  <div style="background:#f8d7da; color:#721c24; padding:12px; border-radius:4px; margin-bottom:16px;">
    <% @room.errors.full_messages.each do |message| %>
      <p><%= message %></p>
    <% end %>
  </div>
<% end %>

<%= form_with model: @room, multipart: true do |f| %>
  <div>
    <%= f.label :name, "施設名" %>
    <%= f.text_field :name %>
  </div>
  <div>
    <%= f.label :description, "施設詳細" %>
    <%= f.text_area :description %>
  </div>
  <div>
    <%= f.label :price, "料金（円/日）" %>
    <%= f.number_field :price %>
  </div>
  <div>
    <%= f.label :address, "住所" %>
    <%= f.text_field :address %>
  </div>
  <div>
    <%= f.label :room_image, "施設画像" %>
    <%= f.file_field :room_image %>
  </div>
  <div style="display:flex; gap:12px; margin-top:8px;">
    <%= f.submit "登録する" %>
    <%= link_to "戻る", rooms_path, style: "background:#888; color:white; padding:8px 20px; border-radius:4px;" %>
  </div>
<% end %>