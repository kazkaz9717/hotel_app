<h1><%= @room.name %></h1>

<% if @room.room_image.attached? %>
  <%= image_tag @room.room_image %>
<% else %>
  <%= image_tag "default_room.png" %>
<% end %>

<p><%= @room.description %></p>
<p>¥<%= @room.price %>/日</p>

<% if logged_in? && @room.user == current_user %>
  <%= link_to "編集する", edit_room_path(@room) %>
  <button onclick="document.getElementById('delete-modal').style.display='flex'">削除する</button>
<% end %>

<%= link_to "予約する", new_reservation_path(room_id: @room.id) %>
<%= link_to "戻る", :back %>

<!-- 削除確認モーダル -->
<div id="delete-modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); justify-content:center; align-items:center;">
  <div style="background:white; padding:32px; border-radius:8px; max-width:400px; width:90%;">
    <h2>施設を削除しますか？</h2>
    <p><%= @room.name %></p>
    <p>¥<%= @room.price %>/日</p>
    <% if @room.room_image.attached? %>
      <%= image_tag @room.room_image, style: "width: 200px; height: 150px; object-fit: cover;" %>
    <% else %>
      <%= image_tag "default_room.png", style: "width: 200px; height: 150px; object-fit: cover;" %>
    <% end %>
    <div style="margin-top:24px; display:flex; gap:16px;">
      <%= link_to "削除する", room_path(@room), data: { turbo_method: :delete }, style: "background:#e74c3c; color:white; padding:8px 20px; border-radius:4px;" %>
      <button onclick="document.getElementById('delete-modal').style.display='none'">キャンセル</button>
    </div>
  </div>
</div>