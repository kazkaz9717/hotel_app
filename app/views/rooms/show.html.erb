<div style="max-width:900px; margin:0 auto;">
  <h1>施設詳細</h1>

  <div class="room-card">
    <div style="display:flex;">

      <div style="flex:1.2;">
        <%= room_image_tag(@room, style: "width:100%; height:500px; object-fit:cover;") %>
      </div>

      <div style="flex:1; padding:32px; display:flex; flex-direction:column; gap:16px;">
        <h1 class="room-name" style="font-size:28px;"><%= @room.name %></h1>
        <p class="room-price" style="font-size:24px;">¥<%= number_with_delimiter(@room.price) %>/日</p>
        <p class="room-address"><%= @room.address %></p>
        <p style="line-height:1.8; color:#555;"><%= @room.description %></p>
      </div>

    </div>
  </div>

  <div class="form-actions">
    <%= link_to "戻る", session[:return_to] || search_rooms_path, class: "btn-secondary" %>
    <div style="display:flex; gap:12px;">
      <%= link_to "予約する", new_reservation_path(room_id: @room.id), class: "btn-primary" %>
      <% if logged_in? && @room.user == current_user %>
        <%= link_to "編集する", edit_room_path(@room), class: "btn-primary" %>
        <%= link_to "削除する", "#",
          onclick: "document.getElementById('delete-modal').style.display='flex'; return false;",
          class: "btn-primary" %>
      <% end %>
    </div>
  </div>

  <!-- 削除確認モーダル -->
  <div id="delete-modal" class="modal-overlay">
    <div class="modal-content">
      <h2>登録を削除しますか？</h2>
      <p class="room-name"><%= @room.name %></p>
      <p class="room-price">¥<%= number_with_delimiter(@room.price) %>/日</p>
      <%= room_image_tag(@room, style: "width: 200px; height: 150px; object-fit: cover;") %>
      <div class="modal-buttons">
        <%= link_to "戻る", "#", onclick: "document.getElementById('delete-modal').style.display='none'; return false;", class: "btn-secondary" %>
        <%= link_to "削除する", room_path(@room), data: { turbo_method: :delete }, class: "btn-primary" %>
      </div>
    </div>
  </div>
</div>