<h1>プロフィールの編集</h1>

<%= form_with model: @user, url: user_path(@user), method: :patch do |f| %>
  <div>
    <%= f.label :icon_image, "アイコン画像URL" %>
    <%= f.text_field :icon_image %>
  </div>
  <div>
    <%= f.label :name, "名前" %>
    <%= f.text_field :name %>
  </div>
  <div>
    <%= f.label :bio, "自己紹介" %>
    <%= f.text_area :bio %>
  </div>
  <%= f.submit "更新する" %>
<% end %>

<%= link_to "戻る", account_users_path %>