<div class="auth-container">
  <h1>プロフィールの編集</h1>

  <%= form_with model: @user, url: user_path(@user), method: :patch, multipart: true do |f| %>
    <div>
      <% if @user.icon_image.attached? %>
        <%= image_tag @user.icon_image, style: "width: 80px; height: 80px; border-radius: 50%;" %>
      <% else %>
        <%= image_tag "default_icon.png", style: "width: 80px; height: 80px; border-radius: 50%;" %>
      <% end %>
    </div>
    <div>
      <%= f.label :icon_image, "アイコン画像" %>
      <%= f.file_field :icon_image %>
    </div>
    <div>
      <%= f.label :name, "名前" %>
      <%= f.text_field :name %>
    </div>
    <div>
      <%= f.label :bio, "自己紹介" %>
      <%= f.text_area :bio %>
    </div>
    <%= f.submit "更新する" %>
  <% end %>

  <%= link_to "戻る", account_users_path %>
</div>