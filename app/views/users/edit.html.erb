<div class="auth-container">
  <h1>プロフィールの編集</h1>

  <% if @user.errors.any? %>
    <div style="background:#f8d7da; color:#721c24; padding:12px; border-radius:4px; margin-bottom:16px;">
      <% @user.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <%= form_with model: @user, url: user_path(@user), method: :patch, multipart: true do |f| %>
    <div>
      <%= icon_image_tag(@user, style: "width: 80px; height: 80px; border-radius: 50%;") %>
    </div>
    <div>
      <%= f.label :icon_image, "アイコン画像" %>
      <%= f.file_field :icon_image %>
    </div>
    <div>
      <%= f.label :name do %>
        <span style="color:red;">*</span>
        名前
      <% end %>
      <%= f.text_field :name %>
    </div>
    <div>
      <%= f.label :bio, "自己紹介" %>
      <%= f.text_area :bio %>
    </div>
    <div style="margin-top:8px;">
      <%= f.submit "更新する", style: "width:80%; display:block; margin:0 auto 8px;" %>
      <a href="<%= account_users_path %>" style="display:block; width:80%; margin:0 auto; background:#888; color:white; border-radius:4px; text-align:center; padding:8px 20px; font-size:14px; box-sizing:border-box;">戻る</a>
    </div>
  <% end %>
</div>